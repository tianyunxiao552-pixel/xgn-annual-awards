{
  "name": "xgn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-fonts.mjs",
    "prebuild": "node scripts/prepare-fonts.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/api.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:public": "node --test tests/public-export.test.mjs",
    "test:cover": "node --test tests/cover.test.mjs",
    "export:public": "node scripts/export-public.mjs",
    "connect": "node scripts/connect-cloudflare.mjs",
    "publish": "node scripts/publish.mjs",
    "format": "prettier --write src server server.mjs vite.config.mjs tests/api.test.mjs"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24"
  }
}
